# ==========================================
# Frappe & ERPNext v16 Enterprise Dev Stack
# ==========================================

# Core Branches
FRAPPE_BRANCH=version-16
ERPNEXT_BRANCH=version-16

# Primary Development Site
SITE_NAME=development.localhost
ADMIN_PASSWORD=admin

# Database Settings
DB_HOST=mariadb
DB_ROOT_PASSWORD=123
MARIADB_PORT=3306

# Redis Settings
REDIS_CACHE=redis://redis-cache:6379
REDIS_QUEUE=redis://redis-queue:6379
REDIS_SOCKETIO=redis://redis-queue:6379

# Exposed Ports
WEB_PORT=8000
SOCKETIO_PORT=9000
WATCHER_PORT=6787
DASHBOARD_PORT=8080

# Compose profiles: "dev" enables the Mailpit mail catcher (remove in production)
COMPOSE_PROFILES=dev

# ------------------------------------------
# Self-Hosted Email (F-006, Stalwart)
# ------------------------------------------
MAIL_DOMAIN=hub.localhost
MAIL_HOSTNAME=mail.hub.localhost
# Stalwart admin (user "admin"); web admin at http://localhost:${MAIL_ADMIN_PORT}
MAIL_ADMIN_PASSWORD=change-me-strong-admin-passphrase
MAIL_ADMIN_PORT=8090
MAIL_SUBMISSION_PORT=465
MAIL_IMAPS_PORT=993
MAILPIT_UI_PORT=8025

# TLS: dev-ca (local CA, dev only) | external (production: ACME/manual certs in Stalwart)
MAIL_TLS_MODE=dev-ca
# MAIL_TLS_EXTRA_SANS=DNS:mail.example.internal
# CA bundle for Frappe's TLS clients (dev CA + system roots). Remove in production.
MAIL_CLIENT_CA_BUNDLE=/etc/eh-mail-trust/ca-bundle.pem
# Spam filter: disabled in dev (no SPF/DKIM for test senders) | enabled in production
MAIL_SPAM_FILTER=disabled

# Outbound route for non-local recipients: mailpit (dev) | mx (direct, needs port 25 + DNS) | relay (smarthost)
MAIL_OUTBOUND_ROUTE=mailpit
# MAIL_RELAY_HOST=smtp.example-provider.com
# MAIL_RELAY_PORT=587
# MAIL_RELAY_USER=
# MAIL_RELAY_PASSWORD=
# MAIL_RELAY_IMPLICIT_TLS=false

# Mailboxes: "localpart:SECRET_ENV_VAR,..." — Stalwart rejects weak passwords
MAIL_ACCOUNTS=notifications:EH_MAIL_NOTIFICATIONS_PASSWORD,support:EH_MAIL_SUPPORT_PASSWORD
EH_MAIL_NOTIFICATIONS_PASSWORD=change-me-strong-notifications-passphrase
EH_MAIL_SUPPORT_PASSWORD=change-me-strong-support-passphrase
